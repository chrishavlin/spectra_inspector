SPECTRA_INSPECTOR_APP_NAME='Spectra Inspector Server'
SPECTRA_INSPECTOR_DATA_ROOT='/TorresBoxSamples'
SPECTRA_INSPECTOR_HOST_DATA_ROOT='/path/to/TorresBoxSamples'
SPECTRA_INSPECTOR_ALLOW_DB_REFRESH=false
SPECTRA_INSPECTOR_DB_ALLOW_MIXED_BASENAMES=false
# on-disk cache of full-extent images and spectra; leave unset for no cache.
# RESULT_CACHE_FILL=true lets the backend add entries it had to compute.
# SPECTRA_INSPECTOR_RESULT_CACHE_DIR='/path/to/result_cache'
# SPECTRA_INSPECTOR_RESULT_CACHE_FILL=false
SPECTRA_INSPECTOR_DESKTOP_MODE=false
# only used in desktop mode; leave unset for no limit
# SPECTRA_INSPECTOR_MAX_DATASETS=500
SPECTRA_INSPECTOR_N_FASTAPI_WORKERS=1
SPECTRA_INSPECTOR_LOG_LEVEL='INFO'
